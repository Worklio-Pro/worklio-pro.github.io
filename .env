# Settings loaded by server.js at startup. Keep this file private: it holds your account keys.
# Restart the server after changing anything here.

# --- Twilio text messages (console.twilio.com → Account Info) ---
# Account SID starts with AC. Auth Token is next to it (click "Show").
TWILIO_ACCOUNT_SID=AC28a26ed65267cc3f61c2c7a077855acf
TWILIO_AUTH_TOKEN=92a302a25b32b97f3c7e76d9756388d4
# Your Twilio phone number, e.g. +17135550100 (or a Messaging Service SID starting with MG)
TWILIO_FROM=+13465728400

# Public address of this app, so links in texts open for your clients (e.g. https://app.tlbgroupllc.com)
BASE_URL=https://workliopro.com
PLATFORM_DOMAIN=workliopro.com

# --- Email delivery (SendGrid: app.sendgrid.com → Settings → API Keys, "Mail Send" access) ---
SENDGRID_API_KEY=
# Sender address. It must be verified in SendGrid (Settings → Sender Authentication), e.g. office@tlbgroupllc.com
EMAIL_FROM=info@tlbgroupllc.com
# Optional: name shown as the sender (defaults to your business name) and where client replies go (defaults to your company email)
EMAIL_FROM_NAME=TLB Group LLC.
MAIL_REPLY_TO=paul@tlbgroupllc.com

# --- Email through your Gmail account (used instead of SendGrid when filled in) ---
# 1. Turn on 2-Step Verification: myaccount.google.com/security
# 2. Create an app password: myaccount.google.com/apppasswords (name it "TLB Jobber"), paste the 16 letters below
GMAIL_USER=paul.cajita@gmail.com
GMAIL_APP_PASSWORD=dxckbxrimsnxmwnn
# Emails come from GMAIL_USER. To send from another address, add it in Gmail → Settings → Accounts → "Send mail as"
# and set EMAIL_FROM to it. EMAIL_FROM_NAME and EMAIL_REPLY_TO above apply to Gmail too.

# --- Stripe: online card payments ---
# Secret key from https://dashboard.stripe.com/apikeys
# Use sk_test_... to try it with Stripe's test cards (no real charges), then sk_live_... to take real payments.
STRIPE_SECRET_KEY=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
# Optional but recommended: webhook signing secret (whsec_...) from Stripe > Developers > Webhooks.
# Endpoint URL: <your BASE_URL>/api/stripe/webhook   Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=

# --- AI Claude (Anthropic) ---
# Get your API key at https://console.anthropic.com/account/api-keys
ANTHROPIC_API_KEY=
